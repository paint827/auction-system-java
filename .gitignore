target/

# IDE files
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# Java class and archive files
bin/
*.class
*.jar
*.war
*.ear

# Runtime data and demo files
data/*.bin
data/*.tmp
!data/.gitkeep
*.log

# Maven wrapper (keep wrapper config but ignore jar if used)
.mvn/wrapper/maven-wrapper.jar

