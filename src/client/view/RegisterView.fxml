<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="950.0"
            style="-fx-background-color: #0b111e;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controller.RegisterController">

    <!-- VÙNG TRUNG TÂM: Căn giữa tự động cả khi phóng to toàn màn hình -->
    <center>
        <StackPane>
            <VBox alignment="CENTER" maxWidth="430.0" maxHeight="-Infinity" spacing="14.0"
                  style="-fx-background-color: #151f32;
                         -fx-background-radius: 24;
                         -fx-border-color: rgba(255, 255, 255, 0.08);
                         -fx-border-width: 1.2;
                         -fx-border-radius: 24;
                         -fx-padding: 30 34 26 34;
                         -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.6), 35, 0, 0, 18);">

                <!-- Icon Header bo góc phát sáng -->
                <VBox alignment="CENTER" maxHeight="56.0" maxWidth="56.0" prefHeight="56.0" prefWidth="56.0"
                      style="-fx-background-color: linear-gradient(to bottom right, #38bdf8, #2563eb);
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.45), 18, 0.2, 0, 4);">
                    <ImageView fitHeight="34.0" fitWidth="34.0" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo-uet-clean.png"/>
                        </image>
                    </ImageView>
                </VBox>

                <!-- Tiêu đề -->
                <VBox alignment="CENTER" spacing="4.0">
                    <Label text="TẠO TÀI KHOẢN MỚI"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff; -fx-font-family: 'Segoe UI', sans-serif;"/>
                    <Label text="Đăng ký tham gia hệ thống đấu giá trực tuyến"
                           style="-fx-font-size: 12.5px; -fx-text-fill: #8194ad;"/>
                </VBox>

                <!-- Form thông tin đăng ký -->
                <VBox spacing="10.0" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <!-- Tên đăng nhập -->
                    <VBox spacing="4.0">
                        <Label text="Tên đăng nhập"
                               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập ít nhất 4 ký tự..." prefHeight="38.0"
                                   style="-fx-background-color: #1e2b42; -fx-text-fill: white; -fx-prompt-text-fill: #5a6e85; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.06); -fx-border-radius: 8; -fx-padding: 0 12;"/>
                    </VBox>

                    <!-- Vai trò người dùng (Chỉ cho phép Bidder hoặc Seller) -->
                    <VBox spacing="4.0">
                        <Label text="Loại tài khoản"
                               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <ComboBox fx:id="roleComboBox" maxWidth="Infinity" prefHeight="38.0"
                                  style="-fx-background-color: #1e2b42;
                 -fx-background-radius: 8;
                 -fx-border-color: rgba(255, 255, 255, 0.06);
                 -fx-border-radius: 8;
                 -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Mật khẩu -->
                    <VBox spacing="4.0">
                        <Label text="Mật khẩu"
                               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <PasswordField fx:id="passwordField" promptText="••••••••" prefHeight="38.0"
                                       style="-fx-background-color: #1e2b42; -fx-text-fill: white; -fx-prompt-text-fill: #5a6e85; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.06); -fx-border-radius: 8; -fx-padding: 0 12;"/>
                    </VBox>

                    <!-- Xác nhận mật khẩu -->
                    <VBox spacing="4.0">
                        <Label text="Xác nhận mật khẩu"
                               style="-fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                        <PasswordField fx:id="confirmPasswordField" onAction="#onRegister" promptText="••••••••" prefHeight="38.0"
                                       style="-fx-background-color: #1e2b42; -fx-text-fill: white; -fx-prompt-text-fill: #5a6e85; -fx-background-radius: 8; -fx-border-color: rgba(255, 255, 255, 0.06); -fx-border-radius: 8; -fx-padding: 0 12;"/>
                    </VBox>
                </VBox>

                <!-- Thông báo trạng thái / Lỗi -->
                <Label fx:id="statusLabel" text="" wrapText="true"
                       style="-fx-text-fill: #f87171; -fx-font-size: 11.5px;"/>

                <!-- Nút Đăng ký (có defaultButton="true" để bấm Enter là kích hoạt) -->
                <Button text="→ Đăng ký tài khoản" onAction="#onRegister" defaultButton="true" maxWidth="Infinity" prefHeight="40.0"
                        style="-fx-background-color: linear-gradient(to right, #0099ff, #1d6fe9);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 13.5px;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0, 153, 255, 0.35), 14, 0.1, 0, 5);"/>

                <HBox alignment="CENTER" spacing="10.0">
                    <Separator HBox.hgrow="ALWAYS" opacity="0.12"/>
                    <Label text="hoặc" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                    <Separator HBox.hgrow="ALWAYS" opacity="0.12"/>
                </HBox>

                <!-- Trở về màn Đăng nhập -->
                <HBox alignment="CENTER" spacing="4.0">
                    <Label text="Đã có tài khoản?" style="-fx-text-fill: #8194ad; -fx-font-size: 12.5px;"/>
                    <Hyperlink text="Đăng nhập ngay" onAction="#onBackToLogin"
                               style="-fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-font-size: 12.5px;"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets bottom="16.0" top="8.0"/>
            </padding>
            <Label text="© 2026 UET Auction System - Secure Authentication"
                   style="-fx-text-fill: #475569; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>
</BorderPane>