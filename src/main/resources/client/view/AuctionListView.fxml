<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #0b111e;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionListController">

    <!-- TOP HEADER -->
    <top>
        <VBox spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-background-color: #151f32; -fx-padding: 14 24; -fx-border-color: rgba(255,255,255,0.06); -fx-border-width: 0 0 1 0;">

                <!-- Logo & Brand -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox alignment="CENTER" maxHeight="38.0" maxWidth="38.0" prefHeight="38.0" prefWidth="38.0"
                          style="-fx-background-color: linear-gradient(to bottom right, #38bdf8, #2563eb); -fx-background-radius: 10;">
                        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo-uet-clean.png" />
                            </image>
                        </ImageView>
                    </VBox>
                    <VBox>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="UET AUCTION SYSTEM" />
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Sàn đấu giá trực tuyến thời gian thực" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- User Profile & Logout -->
                <HBox alignment="CENTER" spacing="12.0">
                    <!-- Nút chức năng riêng theo Role (TV4 sẽ nối màn hình vào đây) -->
                    <Button fx:id="sellerDashboardBtn" managed="false" onAction="#onOpenSellerDashboard" prefHeight="32.0"
                            style="-fx-background-color: #065f46; -fx-text-fill: #34d399; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(52,211,153,0.3); -fx-border-radius: 8;"
                            text="Quản lý hàng bán" visible="false" />
                    <Button fx:id="adminPanelBtn" managed="false" onAction="#onOpenAdminPanel" prefHeight="32.0"
                            style="-fx-background-color: #4c1d95; -fx-text-fill: #c084fc; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(192,132,252,0.3); -fx-border-radius: 8;"
                            text="Bảng điều khiển Admin" visible="false" />

                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;" text="Xin chào, User" />
                        <Label fx:id="roleBadge" style="-fx-font-size: 10px; -fx-text-fill: #38bdf8; -fx-background-color: rgba(56,189,248,0.15); -fx-padding: 2 6; -fx-background-radius: 4;" text="BIDDER" />
                    </VBox>
                    <Button onAction="#onLogout" prefHeight="32.0"
                            style="-fx-background-color: #1e293b; -fx-text-fill: #f87171; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(248,113,113,0.3); -fx-border-radius: 8; -fx-cursor: hand;"
                            text="Đăng xuất" />
                </HBox>
            </HBox>

            <!-- SUB-HEADER: SEARCH & FILTER BAR -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #0e1726; -fx-padding: 12 24; -fx-border-color: rgba(255,255,255,0.04); -fx-border-width: 0 0 1 0;">

                <!-- Search Box -->
                <TextField fx:id="searchField" prefHeight="38.0" prefWidth="280.0" promptText="Tìm theo tên sản phẩm..."
                           style="-fx-background-color: #151f32; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 8; -fx-padding: 0 12;" />

                <!-- Filter Trạng thái -->
                <ComboBox fx:id="statusFilterCombo" prefHeight="38.0" prefWidth="180.0" promptText="Trạng thái"
                          style="-fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 8;" />

                <!-- Filter Danh mục -->
                <ComboBox fx:id="categoryFilterCombo" prefHeight="38.0" prefWidth="180.0" promptText="Danh mục"
                          style="-fx-background-color: #1e293b; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 8;" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Refresh Button -->
                <Button onAction="#onRefresh" prefHeight="38.0"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="Làm mới" />
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: CARDS LIST -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <VBox spacing="14.0">
                <Label fx:id="resultCountLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" text="Đang hiển thị các phiên đấu giá..." />

                <!-- Vùng chứa các Card sản phẩm -->
                <FlowPane fx:id="cardsContainer" hgap="20.0" vgap="20.0" prefWrapLength="980.0" />
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>